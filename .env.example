# SHOPBEE / STORE AI Environment Configuration

# Server Ports
PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000

# Security & JWT Secrets
JWT_ACCESS_SECRET=store_ai_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=store_ai_refresh_secret_super_secure_key_2026

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql://store_ai_user:store_ai_password_2026@localhost:5432/store_ai_db?schema=public
REDIS_URL=redis://localhost:6379

# AI Microservices & Google Gemini API
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# VNPAY Sandbox Configuration
VNPAY_TMN_CODE=SANDBOX_STORE_AI
VNPAY_HASH_SECRET=SANDBOX_HASH_SECRET_KEY
