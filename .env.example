# SHOPBEE / STORE AI Environment Configuration

# Environment Mode (development | production)
NODE_ENV=production

# Server Ports
PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000

# CORS Whitelist (Phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Security & JWT Secrets (BẮT BUỘC thay đổi khi triển khai Production: dùng chuỗi ngẫu nhiên >= 32 bytes)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_minimum_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=1h

# Bảo mật OTP: Đặt "true" CHỈ KHI muốn hiển thị OTP trong response JSON ở môi trường Dev / Demo
ENABLE_DEMO_OTP=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://store_ai_user:store_ai_password_2026@localhost:5432/store_ai_db?schema=public

# AI Microservices & Google Gemini API (AI API)
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local AI Configuration (Ollama / Local FastAPI)
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:latest
AI_PROVIDER_DEFAULT=api

# VNPAY Gateway Configuration
VNPAY_TMN_CODE=SANDBOX_STORE_AI
VNPAY_HASH_SECRET=SANDBOX_HASH_SECRET_KEY

# MoMo Gateway Configuration (Cần khai báo khi lên Production)
# MOMO_PARTNER_CODE=MOMO
# MOMO_ACCESS_KEY=your_momo_access_key
# MOMO_SECRET_KEY=your_momo_secret_key
